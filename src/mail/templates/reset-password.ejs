<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Your Password</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
        Helvetica, Arial, sans-serif;
      background-color: #fdfdff;
    "
  >
    <div
      style="
        max-width: 480px;
        margin: 0 auto;
        padding: 40px 24px;
        background-color: #fdfdff;
      "
    >
      <div style="text-align: center; margin-bottom: 28px">
        <span
          style="
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background-color: #5734ca;
            color: #f3f4f6;
            font-size: 20px;
            font-weight: 700;
          "
          >C</span
        >
        <span
          style="
            display: block;
            margin-top: 12px;
            font-size: 18px;
            font-weight: 700;
            color: #0f0f14;
          "
          >ClassMate</span
        >
      </div>

      <div
        style="
          background-color: #ffffff;
          border: 1px solid #e2e2ee;
          border-radius: 12px;
          padding: 32px 28px;
        "
      >
        <h2
          style="
            margin: 0 0 8px;
            font-size: 20px;
            font-weight: 700;
            color: #0f0f14;
          "
        >
          Reset your password
        </h2>
        <p style="margin: 0 0 24px; font-size: 14px; line-height: 1.6; color: #62627a">
          Hi <%= recipientName %>, you requested to reset your password. Click
          the button below to set a new one.
        </p>
        <div style="text-align: center; margin: 28px 0">
          <a
            href="<%= resetUrl %>"
            style="
              display: inline-block;
              background-color: #5734ca;
              color: #f3f4f6;
              padding: 12px 28px;
              border-radius: 8px;
              font-size: 14px;
              font-weight: 600;
              text-decoration: none;
            "
            >Reset Password</a
          >
        </div>
        <p
          style="
            margin: 24px 0 0;
            font-size: 13px;
            line-height: 1.6;
            color: #62627a;
          "
        >
          If the button doesn't work, copy and paste this link into your
          browser:
        </p>
        <p
          style="
            margin: 8px 0 0;
            font-size: 12px;
            line-height: 1.5;
            color: #5734ca;
            word-break: break-all;
          "
        >
          <a href="<%= resetUrl %>" style="color: #5734ca; text-decoration: none"
            ><%= resetUrl %></a
          >
        </p>
        <p style="margin: 24px 0 0; font-size: 13px; line-height: 1.6; color: #62627a">
          This link will expire in one hour. If you didn't request a password
          reset, you can safely ignore this email.
        </p>
      </div>

      <p
        style="
          margin: 24px 0 0;
          text-align: center;
          font-size: 12px;
          color: #62627a;
        "
      >
        &copy; <%= new Date().getFullYear() %> ClassMate. All rights reserved.
      </p>
    </div>
  </body>
</html>
